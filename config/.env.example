# Copy this file to config/.env (and config/.env.qa / config/.env.stage as needed)
# and fill in real values. config/.env* files are gitignored; this template is not.
#
# Target: self-hosted parasoft/parabank Docker image, run locally via:
#   docker run -d --name parabank -p 8080:8080 -p 61616:61616 -p 9001:9001 parasoft/parabank
#
# The shared public demo (parabank.parasoft.com) was evaluated and rejected as a target —
# see specs/transfer-funds.md for why.
UI_BASE_URL=http://localhost:8080/parabank/
API_BASE_URL=http://localhost:8080/parabank/services/bank
# Seeded test user (john/demo, customer id 12212) is intentionally NOT
# configured here — it's a fixed fact of ParaBank's own seed data, tightly
# coupled to SEEDED_CUSTOMER_ID and every account id in TRANSFER_ACCOUNTS.
# See SEEDED_USER in src/fixtures/base.ts.

# Only required to run `npm run heal:failures` (src/agents/healer/proposeLocatorFix.ts)
# — the LLM-assisted locator repair step. Every other script/test works without it.
# Get a key at https://console.anthropic.com/settings/keys.
# In CI this is read from a GitHub Actions secret of the same name, never committed here.
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-sonnet-4-5-20250929 if unset.
# ANTHROPIC_MODEL=
